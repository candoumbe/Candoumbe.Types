# Optional environment variables for Dev Container customization
# Copy this file to .env and modify as needed
# NuGet cache directory (inside container)
# NUGET_PACKAGES=/home/vscode/.nuget/packages
# .NET telemetry
# DOTNET_CLI_TELEMETRY_OPTOUT=1
# Disable .NET logo
# DOTNET_NOLOGO=1
# Additional tools (uncomment as needed)
# If you need specific tool versions, modify the Dockerfile
